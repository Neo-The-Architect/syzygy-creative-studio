# Optional OpenRouter route for structured planning.
# Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Required when intentionally binding beyond loopback. Keep secret and provide
# it through the operator-controlled process environment; never commit a value.
SYZYGY_CREATIVE_STUDIO_AUTH_TOKEN=

# Optional local resource ceilings. Defaults are bounded and can be lowered
# for a smaller machine or raised deliberately on operator-controlled storage.
SYZYGY_CREATIVE_STUDIO_MAX_ACTIVE_RUNS=2
SYZYGY_CREATIVE_STUDIO_MAX_CREATE_REQUESTS_PER_MINUTE=30
SYZYGY_CREATIVE_STUDIO_MAX_RUN_STORAGE_BYTES=2147483648
SYZYGY_CREATIVE_STUDIO_MAX_INPUT_IMAGES=8
SYZYGY_CREATIVE_STUDIO_MAX_INPUT_IMAGE_BYTES=12582912
